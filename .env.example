# Copy to `.env` for development only; never commit live secrets.
DATABASE_URL=sqlite:///local_test.db
DJANGO_SECRET_KEY=replace-with-a-private-random-secret
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=604800
DJANGO_DEBUG=false
PORT=5001
# Comma-separated frontend origins; set explicitly in production.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8765
GROQ_API_KEY=replace-with-your-provider-api-key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=replace-with-your-provider-api-key
# Choose "resend" on hosts that block outbound SMTP. Verify your sender domain
# with Resend before using it. Keep the API key private.
MAIL_PROVIDER=smtp
RESEND_API_KEY=
MAIL_FROM=
# SMTP settings are used only when MAIL_PROVIDER=smtp.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email_address
MAIL_PASSWORD=your_email_app_password
# Optional; use the OAuth client ID registered for your frontend.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
